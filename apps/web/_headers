# Cache lifetimes for the hand-placed static assets.
#
# adapter-cloudflare copies this file (from the project root — it throws if it
# finds one in static/) to .svelte-kit/cloudflare/_headers and APPENDS its own
# generated block for /_app/* below, so these rules sit on top and cover the
# paths SvelteKit does not hash.
#
# Verify after a build with:
#   bun run build && cat .svelte-kit/cloudflare/_headers
# and after a deploy with `curl -I https://not-the-louvre.art/draco/draco_decoder.wasm`.

# Content-addressed filenames: scripts/generate-static-art.ts names every file
# after a digest of the artwork it holds (GENERATED_ART_VERSION in
# shared-ui/generated-art-version.ts, regenerated at the start of every build),
# so new bytes can only arrive under a new URL. That — not a hand-bumped
# constant — is what makes `immutable` true here.
/generated/*
  Cache-Control: public, max-age=31536000, immutable

# The three ambient tracks are content-stable; a new track gets a new filename.
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# The DRACO decoder is pinned to the installed `three` version and re-copied by
# scripts/copy-draco-decoder.ts; a version bump rewrites these bytes under the
# same name, so revalidate weekly rather than never.
/draco/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

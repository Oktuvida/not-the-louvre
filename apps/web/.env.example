# Postgres: `bun run db:start` serves one on this URL (compose.yaml)
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:55432/postgres"

# In production set this to the public HTTPS origin of the deployment, e.g. https://not-the-louvre.art
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Images and drawing documents live in the R2 bucket bound as BUCKET, and live
# updates in the realtime Worker's Durable Objects, both declared in
# wrangler.jsonc. `wrangler dev` and the test suites emulate them locally, so
# they need no configuration here.

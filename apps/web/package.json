{
	"name": "@not-the-louvre/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run scripts/generate-static-art.ts && bun run scripts/copy-draco-decoder.ts && bun run scripts/build-production.ts",
		"build:e2e": "bun run scripts/build-e2e.ts",
		"model:transform:studio": "bun run scripts/transform-studio-model.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && tsc --noEmit -p ./tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && prettier --check . && eslint . && bun run scripts/check-scoped-keyframes.ts",
		"format": "prettier --write .",
		"test:unit": "bun run test:unit:server && bun run test:unit:client",
		"test:unit:server": "vitest run --project server",
		"test:unit:client": "vitest run --project client",
		"test:integration": "RUN_INTEGRATION=1 vitest run --project server",
		"test:contract": "RUN_INTEGRATION=1 vitest run --project server src/lib/server/artwork/db.contract.integration.test.ts",
		"test": "bun run test:unit && bun run test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:platform-objects": "bun run scripts/db/apply-sql.ts scripts/db/supabase-platform-objects.sql",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run scripts/seed-artworks.ts",
		"db:reset": "cd ../.. && bun run db:reset",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes && bun run scripts/generate-auth-schema.ts"
	},
	"dependencies": {
		"@2toad/profanity": "^3.3.0",
		"@fontsource/baloo-2": "^5.3.0",
		"@fontsource/caveat": "^5.3.0",
		"@fontsource/fredoka": "^5.3.0",
		"@jsquash/avif": "^2.1.1",
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/resize": "^2.1.1",
		"@jsquash/webp": "^1.5.0",
		"@resvg/resvg-wasm": "^2.6.2",
		"@supabase/supabase-js": "^2.100.1",
		"@threlte/core": "^8.5.2",
		"@threlte/extras": "^9.13.0",
		"better-auth": "~1.4.21",
		"drizzle-orm": "^0.45.1",
		"gsap": "^3.14.2",
		"jose": "^6.2.2",
		"lucide-svelte": "^1.0.1",
		"pg": "^8.23.1",
		"three": "^0.183.2",
		"virtua": "^0.49.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@types/three": "^0.183.1",
		"@vitest/browser-playwright": "^4.1.0",
		"drizzle-kit": "^0.31.8",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"fake-indexeddb": "^6.2.5",
		"fflate": "^0.8.2",
		"globals": "^17.4.0",
		"playwright": "^1.58.2",
		"postgres": "^3.4.8",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sharp": "^0.34.5",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.0.2",
		"wrangler": "^4.100.0"
	}
}

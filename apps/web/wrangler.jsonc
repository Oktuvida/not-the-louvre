{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "not-the-louvre",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-06-01",
	// nodejs_compat covers node:async_hooks (SvelteKit), node:crypto (better-auth)
	// and the TCP sockets shim that postgres.js uses on Workers.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Hyperdrive terminates Postgres at the local colo over warm pooled
	// connections to Supavisor, turning each request's fresh dial (~1s of
	// TCP+TLS+auth per navigation) into a local connect. Create it once with
	//   wrangler hyperdrive create not-the-louvre-db --connection-string="<production DATABASE_URL>"
	// then paste the returned id below and uncomment. The app falls back to
	// dialing DATABASE_URL directly while this binding is absent.
	// "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id>" }],
	// Mirrors the dashboard state so deploys don't flip logging: persisted
	// Workers Logs on (incident forensics depend on them), traces off.
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		}
	}
	// AVIF encoding in WASM can take several seconds of CPU per upload. The
	// Workers paid plan defaults to 30s CPU per request which is enough; on the
	// free plan (10ms) media publishing will not work. Uncomment to raise:
	// "limits": { "cpu_ms": 60000 }
}

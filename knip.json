{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreExportsUsedInFile": { "interface": true, "type": true },
	"ignoreIssues": {
		"apps/web/src/lib/server/db/auth.schema.ts": ["exports"],
		"apps/web/src/lib/server/db/schema.ts": ["exports"]
	},
	"tags": ["-knipignore"],
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.ts"],
			"project": ["scripts/**/*.ts"],
			"svelte": false
		},
		"apps/web": {
			"svelte": {
				"config": ["svelte.config.js"]
			},
			"drizzle": false,
			"entry": ["scripts/**/*.{ts,mjs}", "src/**/*.e2e.ts"],
			"project": ["src/**/*.{ts,svelte,css}", "scripts/**/*.{ts,mjs}"],
			"ignoreDependencies": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"]
		},
		"packages/stroke-json-runtime": {
			"project": ["src/**/*.ts"]
		}
	}
}

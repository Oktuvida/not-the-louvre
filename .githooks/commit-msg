#!/bin/sh
# commit-msg hook — validates messages against AGENTS.md convention:
#   <emoji> <type>[(scope)][!]: <description>
#
# POSIX only: no `grep -P`, because BSD grep (macOS) has no PCRE support.
# Install it with `bun run hooks:install` (git config core.hooksPath .githooks).

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -1 "$COMMIT_MSG_FILE")

# Skip commits generated by git itself
case "$FIRST_LINE" in
  "Merge branch "* | "Merge pull request "* | "Merge remote-tracking "* | \
  "Revert \""* | "fixup! "* | "squash! "*)
    exit 0 ;;
esac

# ANSI colours when stderr is a terminal
if [ -t 2 ]; then
  RED='\033[0;31m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'
  BOLD='\033[1m';   NC='\033[0m'
else
  RED=''; YELLOW=''; CYAN=''; BOLD=''; NC=''
fi

_err()  { printf "%b[commit-msg]%b %s\n"   "${RED}${BOLD}" "$NC" "$1" >&2; }
_hint() { printf "%bHint:%b          %s\n" "$YELLOW"        "$NC" "$1" >&2; }
_info() { printf "%b%s:%b             %s\n" "$CYAN" "$1" "$NC" "$2" >&2; }

# U+FE0F VARIATION SELECTOR-16. Emoji are typed both with and without it
# (⚡ vs ⚡️, ♻ vs ♻️), and the two are the same emoji to a reader, so both
# sides of the comparison get it stripped before matching.
VARIATION_SELECTOR=$(printf '\357\270\217')

_strip_variation_selector() {
  printf '%s' "$1" | sed "s/${VARIATION_SELECTOR}//g"
}

VALID_TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

# ── 1. Overall format ─────────────────────────────────────────────────────────
# Must match:  <emoji> <type>[(scope)][!]: <description>
if ! printf '%s' "$FIRST_LINE" | grep -Eq \
    "^[^[:space:]]+[[:space:]]+(${VALID_TYPES})(\([^)]+\))?!?:[[:space:]]+[^[:space:]]"; then
  _err  "Commit message does not match the required format."
  _hint "<emoji> <type>[(scope)][!]: <description>"
  _info "Example" "✨ feat(gallery): add artwork forking flow"
  _info "Yours  " "$FIRST_LINE"
  printf '\n' >&2
  exit 1
fi

# ── 2. Extract emoji and type ─────────────────────────────────────────────────
EMOJI=$(printf '%s' "$FIRST_LINE" | sed -E 's/^([^[:space:]]+).*/\1/')
TYPE=$(printf '%s' "$FIRST_LINE" | sed -E "s/^[^[:space:]]+[[:space:]]+(${VALID_TYPES}).*/\1/")

# ── 3. Validate emoji ↔ type pairing ─────────────────────────────────────────
case "$TYPE" in
  feat)     EXPECTED="✨"  ;;
  fix)      EXPECTED="🐛"  ;;
  docs)     EXPECTED="📝"  ;;
  style)    EXPECTED="💄"  ;;
  refactor) EXPECTED="♻️"  ;;
  perf)     EXPECTED="⚡"  ;;
  test)     EXPECTED="✅"  ;;
  build)    EXPECTED="🏗️" ;;
  ci)       EXPECTED="👷"  ;;
  chore)    EXPECTED="🧹"  ;;
  revert)   EXPECTED="⏪"  ;;
esac

if [ "$(_strip_variation_selector "$EMOJI")" != "$(_strip_variation_selector "$EXPECTED")" ]; then
  _err  "Emoji does not match type '${TYPE}'."
  _hint "Use '${EXPECTED}' for '${TYPE}', got '${EMOJI}'"
  printf '\n' >&2
  exit 1
fi

# ── 4. Description must not end with a period ─────────────────────────────────
DESCRIPTION=$(printf '%s' "$FIRST_LINE" | sed -E 's/^[^:]*:[[:space:]]*//')
case "$DESCRIPTION" in
  *.)
    _err  "Description must not end with a period."
    _hint "Remove the trailing '.' from: ${DESCRIPTION}"
    printf '\n' >&2
    exit 1 ;;
esac

exit 0
